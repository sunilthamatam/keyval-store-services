      ]
    },
    {
      "name": "Snapshot Management",
      "item": [
        {
          "name": "Create Snapshot",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/snapshot/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "snapshot", "create"]
            },
            "description": "Create a snapshot of the current data"
          },
          "response": []
        },
        {
          "name": "List Snapshots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/snapshot/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "snapshot", "list"]
            },
            "description": "Get a list of all available snapshots"
          },
          "response": []
        },
        {
          "name": "Load Snapshot",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/snapshot/load?snapshotName=snapshot-2025-01-19T10-30-00.gz",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "snapshot", "load"],
              "query": [
                {
                  "key": "snapshotName",
                  "value": "snapshot-2025-01-19T10-30-00.gz"
                }
              ]
            },
            "description": "Restore data from a snapshot"
          },
          "response": []
        }
      ]
    },
