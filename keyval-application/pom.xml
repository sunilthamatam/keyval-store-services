<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.constelld.keyvalstore</groupId>
        <artifactId>keyval-store-services</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>keyval-application</artifactId>
    <packaging>jar</packaging>

    <name>KeyVal Store Application</name>
    <description>Main application entry point and integration</description>

    <dependencies>
        <!-- All internal modules -->
        <dependency>
            <groupId>com.constelld.keyvalstore</groupId>
            <artifactId>keyval-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.constelld.keyvalstore</groupId>
            <artifactId>keyval-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.constelld.keyvalstore</groupId>
            <artifactId>keyval-cluster</artifactId>
        </dependency>
        <dependency>
            <groupId>com.constelld.keyvalstore</groupId>
            <artifactId>keyval-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.constelld.keyvalstore</groupId>
            <artifactId>keyval-api</artifactId>
        </dependency>

        <!-- DropWizard -->
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-core</artifactId>
        </dependency>

        <!-- Swagger/OpenAPI -->
        <dependency>
            <groupId>com.smoketurner</groupId>
            <artifactId>dropwizard-swagger</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.dropwizard</groupId>
            <artifactId>dropwizard-testing</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>com.constelld.keyvalstore.application.KeyValStoreApplication</mainClass>
                        </transformer>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                            </excludes>
                        </filter>
                    </filters>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
